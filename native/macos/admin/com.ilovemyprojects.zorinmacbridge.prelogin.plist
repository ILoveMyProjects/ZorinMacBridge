<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ilovemyprojects.zorinmacbridge.prelogin</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/ZorinMacBridge Server.app/Contents/MacOS/ZorinMacBridge Server</string>
    <string>--prelogin-server</string>
  </array>
  <key>LimitLoadToSessionType</key>
  <string>LoginWindow</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/var/log/zorinmacbridge-prelogin.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/zorinmacbridge-prelogin.err</string>
</dict>
</plist>
