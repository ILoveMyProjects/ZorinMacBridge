<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ilovemyprojects.zorinmacbridge.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/zmb-admin</string>
    <string>auto-update-run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/var/log/zorinmacbridge-update.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/zorinmacbridge-update.err</string>
</dict>
</plist>
