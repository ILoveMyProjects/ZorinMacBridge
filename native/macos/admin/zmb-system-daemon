#!/bin/bash
set -u

# Root recovery worker. It exposes no custom network listener. SSH remains the
# administration transport. The dns-sd child only advertises that this Mac's P0
# system service exists, so Zorin can rediscover the current DHCP address even
# when the user-session desktop app is down.
ADMIN_CONFIG="/Library/Application Support/ZorinMacBridge/Admin/config"
ADVERTISER_PID=""
HEARTBEAT_DIR="/var/run/zorinmacbridge-admin"
ADVERTISER_PID_FILE="$HEARTBEAT_DIR/advertiser.pid"

config_value() {
  local key="$1" default="${2:-}" line
  [ -f "$ADMIN_CONFIG" ] || { printf '%s\n' "$default"; return; }
  line="$(/usr/bin/awk -F= -v k="$key" '$1==k {sub(/^[^=]*=/, ""); print; exit}' "$ADMIN_CONFIG" 2>/dev/null || true)"
  [ -n "$line" ] && printf '%s\n' "$line" || printf '%s\n' "$default"
}

installed_app_version() {
  local app='/Applications/ZorinMacBridge Server.app' version='' version_file=''
  if [ -f "$app/Contents/Info.plist" ]; then
    version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist" 2>/dev/null || true)"
  fi
  if [ -z "$version" ]; then
    version_file="$(/usr/bin/find "$app/Contents" -maxdepth 4 -type f -name VERSION -print -quit 2>/dev/null || true)"
    [ -z "$version_file" ] || version="$(/bin/cat "$version_file" 2>/dev/null | /usr/bin/tr -d '[:space:]')"
  fi
  printf '%s\n' "$version"
}

stop_advertiser() {
  if [ -n "$ADVERTISER_PID" ]; then
    /bin/kill "$ADVERTISER_PID" >/dev/null 2>&1 || true
    wait "$ADVERTISER_PID" 2>/dev/null || true
    ADVERTISER_PID=""
    /bin/rm -f "$ADVERTISER_PID_FILE" 2>/dev/null || true
  fi
}

start_advertiser() {
  [ -x /usr/bin/dns-sd ] || return 0
  /bin/mkdir -p "$HEARTBEAT_DIR"
  local sid name version
  sid="$(config_value SERVER_ID '')"
  name="$(config_value SERVER_NAME 'Mac')"
  version="$(installed_app_version)"
  [ -n "$sid" ] || return 0
  /usr/bin/dns-sd -R "$name" _zorinmacbridge-admin._tcp local 22 \
    "app=ZorinMacBridge" "platform=macOS" "role=system" "server_id=$sid" "protocol=2" "version=$version" \
    >/dev/null 2>&1 &
  ADVERTISER_PID="$!"
  printf '%s\n' "$ADVERTISER_PID" > "$ADVERTISER_PID_FILE"
  /bin/chmod 644 "$ADVERTISER_PID_FILE" 2>/dev/null || true
}

trap 'stop_advertiser; exit 0' TERM INT
trap 'stop_advertiser' EXIT

while true; do
  if [ -z "$ADVERTISER_PID" ] || ! /bin/kill -0 "$ADVERTISER_PID" >/dev/null 2>&1; then
    stop_advertiser
    start_advertiser
  fi
  /usr/local/sbin/zmb-admin daemon-tick || true
  /bin/sleep 5
done
