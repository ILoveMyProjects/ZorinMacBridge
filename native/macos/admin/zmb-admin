  [ -n "$cpu_usage" ] || cpu_usage=unknown
  memory_summary="$(printf '%s\n' "$top_out" | /usr/bin/awk '/^PhysMem:/ {sub(/^PhysMem:[[:space:]]*/,""); print; exit}')"
  [ -n "$memory_summary" ] || memory_summary=unknown
  loadavg="$(/usr/sbin/sysctl -n vm.loadavg 2>/dev/null | /usr/bin/sed 's/^{[[:space:]]*//; s/[[:space:]]*}$//' || true)"
