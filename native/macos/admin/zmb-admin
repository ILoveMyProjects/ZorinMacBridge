  prelogin_probe_present=0; [ -f "$CAPABILITY_STATUS_FILE" ] && prelogin_probe_present=1 || true
  proof_version="$(capability_status_value app_version '')"
  proof_cdhash="$(capability_status_value app_cdhash '' | /usr/bin/tr '[:upper:]' '[:lower:]')"
  prelogin_probe_overall="$(capability_status_value overall never)"
  prelogin_probe_capture="$(capability_status_value capture_result unknown)"
  prelogin_probe_input_corehid="$(capability_status_value input_corehid_result unknown)"
