recover_prelogin_cmd() {
  require_root
  local user uid home port i detail
  user="$(target_user || true)"; [ -n "$user" ] || fail "target user is not configured" 69
  uid="$(user_uid "$user" || true)"; [ -n "$uid" ] || fail "cannot resolve target user uid" 69
  home="$(user_home "$user" || true)"; [ -n "$home" ] || fail "cannot resolve target user home" 69
  if user_session_available "$uid"; then
    fail "target user's Aqua session is already logged in; use recover-desktop" 69
  fi
  prelogin_console_active || fail "macOS LoginWindow session is not currently active" 69
  repair_prelogin_agent || {
    detail="$(/usr/bin/tail -n 8 /var/log/zorinmacbridge-prelogin.err 2>/dev/null | /usr/bin/tr '\n' ' ' | /usr/bin/cut -c1-700)"
    [ -n "$detail" ] || detail="launchd did not start the LoginWindow helper"
    fail "could not start LoginWindow pre-login Desktop: $detail" 70
  }
  port="$(settings_value "$home/.zorin-mac-bridge/server-settings.json" port "$DEFAULT_PORT")"
  i=1
  while [ "$i" -le 20 ]; do
    port_listening "$port" && { printf 'ok=prelogin-ready\nport=%s\n' "$port"; return 0; }
    /bin/sleep 0.5
    i=$((i + 1))
  done
  detail="$(/usr/bin/tail -n 8 /var/log/zorinmacbridge-prelogin.err 2>/dev/null | /usr/bin/tr '\n' ' ' | /usr/bin/cut -c1-700)"
  [ -n "$detail" ] || detail="helper did not open the configured Desktop port"
  fail "LoginWindow pre-login Desktop did not become ready: $detail" 70
}

