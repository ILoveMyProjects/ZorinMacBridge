power_status() {
  local batt source percent detail
  batt="$(/usr/bin/pmset -g batt 2>/dev/null || true)"
  source="$(printf '%s\n' "$batt" | /usr/bin/sed -n "1s/.*Now drawing from '\([^']*\)'.*/\1/p")"
  percent="$(printf '%s\n' "$batt" | /usr/bin/grep -Eo '[0-9]+%' | /usr/bin/head -n1 | /usr/bin/tr -d '%')"
  detail="$(printf '%s\n' "$batt" | /usr/bin/sed -n '2p' | /usr/bin/sed 's/^[[:space:]]*//')"
