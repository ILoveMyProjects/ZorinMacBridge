  local u home f
  u="$(target_user || true)"; [ -n "$u" ] || return 0
  home="$(user_home "$u" || true)"; [ -n "$home" ] || return 0
  f="$home/.ssh/authorized_keys"
  /usr/bin/sudo -u "$u" /usr/bin/test -f "$f" 2>/dev/null || return 0
  /usr/bin/sudo -u "$u" /usr/bin/grep 'ZorinMacBridge-Admin:' "$f" 2>/dev/null | /usr/bin/sed -nE 's/.*ZorinMacBridge-Admin:([A-Za-z0-9._-]+).*/device_id=\1/p'
}

unpair_device() {
  require_root
  local id="$1" u home f rc
  printf '%s' "$id" | /usr/bin/grep -Eq '^[A-Za-z0-9._-]{8,80}$' || fail "invalid device id" 64
  u="$(target_user || true)"; [ -n "$u" ] || fail "target user is not configured" 69
  home="$(user_home "$u" || true)"; [ -n "$home" ] || fail "cannot resolve user home" 69
  f="$home/.ssh/authorized_keys"
  # authorized_keys is owned by the desktop user. Perform the complete read,
  # filter, temp-file creation and atomic replace as that user; never grant root
  # file-read/write semantics to a user-controlled path.
  /usr/bin/sudo -u "$u" /bin/sh -c '
    set -e
    f="$1"; id="$2"
    [ -f "$f" ] || exit 66
    [ ! -L "$f" ] || exit 65
    dir=${f%/*}
    tmp=$(/usr/bin/mktemp "$dir/.zmb-authorized_keys.XXXXXX")
    trap '"'"'/bin/rm -f "$tmp"'"'"' EXIT HUP INT TERM
    /usr/bin/awk -v marker="ZorinMacBridge-Admin:${id}" '"'"'index($0, marker)==0 {print}'"'"' "$f" > "$tmp"
    /bin/chmod 600 "$tmp"
    /bin/mv -f "$tmp" "$f"
    trap - EXIT HUP INT TERM
  ' zmb-unpair "$f" "$id"
  rc=$?
  [ "$rc" -eq 0 ] || fail "could not safely update authorized_keys while unpairing (code $rc)" "$rc"
  printf 'ok=unpaired\ndevice_id=%s\n' "$id"
}

logs_cmd() {
  require_root
  printf '%s\n' '--- zmb admin daemon stdout ---'
  /usr/bin/tail -n 100 "$DAEMON_LOG" 2>/dev/null || true
  printf '%s\n' '--- zmb admin daemon stderr ---'
  /usr/bin/tail -n 100 "$DAEMON_ERR" 2>/dev/null || true
  printf '%s\n' '--- zmb recovery events ---'
  /usr/bin/tail -n 160 "$RECOVERY_LOG" 2>/dev/null || true
  printf '%s\n' '--- zmb pre-login stdout ---'
  /usr/bin/tail -n 120 /var/log/zorinmacbridge-prelogin.log 2>/dev/null || true
  printf '%s\n' '--- zmb pre-login stderr ---'
  /usr/bin/tail -n 120 /var/log/zorinmacbridge-prelogin.err 2>/dev/null || true
}

case "${1:-}" in
  status) status_cmd ;;
  start-zmb) start_zmb ;;
  stop-zmb) stop_zmb ;;
  restart-zmb) restart_zmb ;;
  recover-desktop) recover_desktop_cmd ;;
  recover-prelogin) recover_prelogin_cmd ;;
  repair-launch-agent) repair_launch_agent ;;
  daemon-tick) daemon_tick ;;
  autoheal) autoheal ;;
  auto-update-run) auto_update_run ;;
  pairing-list) pairing_list ;;
  unpair) [ "$#" -eq 2 ] || fail "usage: zmb-admin unpair DEVICE_ID" 64; unpair_device "$2" ;;
  logs) logs_cmd ;;
  diagnose) diagnose_cmd ;;
  recover-all) recover_all_cmd ;;
  capability-probe) [ "$#" -eq 1 ] || fail "usage: zmb-admin capability-probe" 64; capability_probe_cmd ;;
  check-update) check_update_cmd ;;
  update-now) update_now_cmd ;;
  set-auto-update) [ "$#" -eq 2 ] || fail "usage: zmb-admin set-auto-update off|notify|install" 64; set_auto_update_cmd "$2" ;;
  set-wake-network) [ "$#" -eq 2 ] || fail "usage: zmb-admin set-wake-network on|off" 64; set_wake_network_cmd "$2" ;;
  wake-display) [ "$#" -eq 1 ] || fail "usage: zmb-admin wake-display" 64; wake_display_cmd ;;
  xcode-overview) xcode_overview_cmd ;;
  xcode-open) xcode_open_cmd ;;
  sim-open) sim_open_cmd ;;
  sim-boot) [ "$#" -eq 2 ] || fail "usage: zmb-admin sim-boot UDID" 64; sim_boot_cmd "$2" ;;
  sim-shutdown) [ "$#" -eq 2 ] || fail "usage: zmb-admin sim-shutdown UDID" 64; sim_shutdown_cmd "$2" ;;
  sleep) require_root; /usr/bin/pmset sleepnow ;;
  reboot)
    require_root
    fv="$(filevault_state)"
    if [ "$fv" = "off" ]; then
      /sbin/shutdown -r now
      exit $?
    fi
    osver="$(/usr/bin/sw_vers -productVersion 2>/dev/null || true)"
    major="${osver%%.*}"
    remote_login="$(remote_login_state)"
    if [ "$fv" = "on" ] && printf '%s' "$major" | /usr/bin/grep -Eq '^[0-9]+$' && [ "$major" -ge 26 ] && [ "$remote_login" = "on" ]; then
      /sbin/shutdown -r now
      exit $?
    fi
    fail "reboot blocked: FileVault may require local unlock; use the Mac locally or make remote preboot unlock eligible first" 78
    ;;
  shutdown) require_root; /sbin/shutdown -h now ;;
  *)
    cat >&2 <<'USAGE'
Usage: zmb-admin COMMAND
  status
  start-zmb
  stop-zmb
  restart-zmb
  recover-desktop
  recover-prelogin
  repair-launch-agent
  auto-update-run
  pairing-list
  unpair DEVICE_ID
  logs
  diagnose
  recover-all
  capability-probe
  check-update
  update-now
  set-auto-update off|notify|install
  set-wake-network on|off
  wake-display
  xcode-overview
  xcode-open
  sim-open
  sim-boot UDID
  sim-shutdown UDID
  sleep
  reboot
  shutdown
USAGE
    exit 64
    ;;
esac
