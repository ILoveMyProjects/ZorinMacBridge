session_pair() {
  local user uid
  user="$(target_user || true)"
  [ -n "$user" ] || fail "target user is not configured" 69
  uid="$(user_uid "$user" || true)"
  [ -n "$uid" ] || fail "cannot resolve target user uid" 69
  user_session_available "$uid" || fail "target user's GUI session is not logged in" 69
  printf '%s:%s\n' "$user" "$uid"
}

write_launch_agent() {
  local user="$1" uid="$2" home dir plist source_tmp
  home="$(user_home "$user" || true)"
  [ -n "$home" ] || fail "cannot resolve user home" 69
  dir="$home/Library/LaunchAgents"
  plist="$dir/${LABEL}.plist"

  # Build the template in root-owned /var/tmp, then let the target user create
  # and atomically rename the destination. Root must never redirect into a path
  # inside a user-writable directory (symlink overwrite / TOCTOU).
  source_tmp="$(/usr/bin/mktemp /var/tmp/zmb-launchagent.XXXXXX)" || fail "could not create launch-agent template" 73
  /bin/cat > "$source_tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${LABEL}</string>
<key>ProgramArguments</key><array><string>/usr/bin/open</string><string>-a</string><string>${APP_NAME}</string></array>
<key>RunAtLoad</key><true/>
</dict></plist>
PLIST
  /bin/chmod 644 "$source_tmp"
  if ! /usr/bin/sudo -u "$user" /bin/sh -c '
    set -e
    dir="$1"; plist="$2"; src="$3"
    /bin/mkdir -p "$dir"
    tmp=$(/usr/bin/mktemp "$dir/.zmb-launchagent.XXXXXX")
    trap '"'"'/bin/rm -f "$tmp"'"'"' EXIT HUP INT TERM
    /bin/cp "$src" "$tmp"
    /bin/chmod 600 "$tmp"
    /bin/mv -f "$tmp" "$plist"
    trap - EXIT HUP INT TERM
  ' zmb-launchagent "$dir" "$plist" "$source_tmp"; then
    /bin/rm -f "$source_tmp"
    fail "could not write the user LaunchAgent safely" 74
  fi
  /bin/rm -f "$source_tmp"
  if user_session_available "$uid"; then
    local attempt=1
    /bin/launchctl bootout "gui/${uid}/${LABEL}" >/dev/null 2>&1 || true
    while [ "$attempt" -le 12 ]; do
      ! launch_agent_loaded "$uid" && break
      /bin/sleep 0.25
      attempt=$((attempt + 1))
    done
    attempt=1
    while [ "$attempt" -le 12 ]; do
      /bin/launchctl bootstrap "gui/${uid}" "$plist" >/dev/null 2>&1 || true
      launch_agent_loaded "$uid" && return 0
      /bin/sleep 0.25
      attempt=$((attempt + 1))
    done
    return 1
  fi
  return 0
}

start_zmb() {
  require_root
  local pair user uid
  pair="$(session_pair)" || exit $?
  user="${pair%%:*}"; uid="${pair##*:}"
  [ -d "$APP_PATH" ] || fail "ZorinMacBridge Server is not installed in /Applications" 66
  /bin/mkdir -p "$HEARTBEAT_DIR"
  /bin/rm -f "$PAUSE_FILE"
  /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open -a "$APP_NAME" >/dev/null 2>&1 || fail "failed to start ZorinMacBridge Server" 70
  printf 'ok=started\n'
}

stop_zmb() {
  require_root
  local pair user uid i
  pair="$(session_pair)" || exit $?
  user="${pair%%:*}"; uid="${pair##*:}"
  /bin/mkdir -p "$HEARTBEAT_DIR"
  /usr/bin/touch "$PAUSE_FILE"
  /bin/chmod 644 "$PAUSE_FILE"
  /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/osascript -e 'tell application "ZorinMacBridge Server" to quit' >/dev/null 2>&1 || true
  for i in 1 2 3 4 5; do
    zmb_process_running "$uid" || { printf 'ok=stopped\n'; return 0; }
    /bin/sleep 1
  done
  /usr/bin/pkill -TERM -u "$uid" -f '/Applications/ZorinMacBridge Server\.app/' >/dev/null 2>&1 || true
  /bin/sleep 1
  zmb_process_running "$uid" && fail "ZorinMacBridge Server did not stop" 70
  printf 'ok=stopped\n'
}

restart_zmb() {
  require_root
  stop_zmb >/dev/null 2>&1 || true
  /bin/rm -f "$PAUSE_FILE"
  /bin/sleep 1
  start_zmb
}

repair_launch_agent() {
  require_root
  local user uid
  user="$(target_user || true)"
  [ -n "$user" ] || fail "target user is not configured" 69
  uid="$(user_uid "$user" || true)"
  [ -n "$uid" ] || fail "cannot resolve target user uid" 69
  write_launch_agent "$user" "$uid" || fail "could not register the desktop LaunchAgent" 70
  if user_session_available "$uid"; then
    printf 'ok=launch-agent-repaired\nsession_available=1\n'
  else
    printf 'ok=launch-agent-written\nsession_available=0\n'
  fi
}

autoheal() {
  require_root
  local enabled user uid home plist port count
  enabled="$(config_value AUTOHEAL 1)"
  [ "$enabled" = "1" ] || return 0
  [ ! -f "$PAUSE_FILE" ] || return 0
  user="$(target_user || true)"; [ -n "$user" ] || return 0
  uid="$(user_uid "$user" || true)"; [ -n "$uid" ] || return 0
  user_session_available "$uid" || { /bin/rm -f "$PORT_FAIL_FILE" 2>/dev/null || true; return 0; }
  [ -d "$APP_PATH" ] || return 0
  home="$(user_home "$user" || true)"; [ -n "$home" ] || return 0
  plist="$home/Library/LaunchAgents/${LABEL}.plist"
  port="$(settings_value "$home/.zorin-mac-bridge/server-settings.json" port "$DEFAULT_PORT")"
  if [ ! -f "$plist" ]; then
    if write_launch_agent "$user" "$uid"; then
      recovery_log INFO AUTOHEAL_LA_CREATED "Auto-recovery recreated and loaded the desktop LaunchAgent."
    else
      recovery_log ERROR AUTOHEAL_LA_FAILED "Auto-recovery could not recreate/register the desktop LaunchAgent."
      return 0
    fi
  elif ! launch_agent_loaded "$uid"; then
    if write_launch_agent "$user" "$uid"; then
      recovery_log INFO AUTOHEAL_LA_LOADED "Auto-recovery re-registered the desktop LaunchAgent."
    else
      recovery_log ERROR AUTOHEAL_LA_FAILED "Auto-recovery could not register the desktop LaunchAgent."
      return 0
    fi
  fi
  if ! zmb_process_running "$uid"; then
    /bin/rm -f "$PORT_FAIL_FILE" 2>/dev/null || true
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open -a "$APP_NAME" >/dev/null 2>&1 || true
    recovery_log INFO AUTOHEAL_DESKTOP_STARTED "Auto-recovery started the desktop application."
    return 0
  fi
  if port_listening "$port"; then
    /bin/rm -f "$PORT_FAIL_FILE" 2>/dev/null || true
    return 0
  fi
  count="$(/bin/cat "$PORT_FAIL_FILE" 2>/dev/null || echo 0)"
  printf '%s' "$count" | /usr/bin/grep -Eq '^[0-9]+$' || count=0
  count=$((count + 1))
  printf '%s\n' "$count" > "$PORT_FAIL_FILE"
  /bin/chmod 644 "$PORT_FAIL_FILE" 2>/dev/null || true
  if [ "$count" -ge 3 ]; then
    recovery_log WARN AUTOHEAL_PORT_STUCK "Desktop process stayed up without a listening port for three recovery ticks; restarting it."
    /bin/rm -f "$PORT_FAIL_FILE"
    restart_zmb >/dev/null 2>&1 || recovery_log ERROR AUTOHEAL_RESTART_FAILED "Automatic desktop restart failed."
  fi
}

run_app_as_target_user() {
  require_root
  local user uid home
  user="$(target_user || true)"; [ -n "$user" ] || fail "target user is not configured" 69
  uid="$(user_uid "$user" || true)"; [ -n "$uid" ] || fail "cannot resolve target user uid" 69
  home="$(user_home "$user" || true)"; [ -n "$home" ] || fail "cannot resolve target user home" 69
  [ -x "$APP_BIN" ] || fail "ZorinMacBridge Server executable is missing from /Applications" 66
  /usr/bin/sudo -u "$user" /usr/bin/env HOME="$home" USER="$user" LOGNAME="$user" "$APP_BIN" "$@"
}

run_app_for_root_update() {
  require_root
  local user home token
  user="$(target_user || true)"; [ -n "$user" ] || fail "target user is not configured" 69
  home="$(user_home "$user" || true)"; [ -n "$home" ] || fail "cannot resolve target user home" 69
  token="$(config_value LOCAL_IDENTITY_TOKEN '')"
  printf '%s' "$token" | /usr/bin/grep -Eq '^[0-9a-f]{64}$' || fail "root P0 config is missing a valid local identity token; run Enable / Repair locally once" 69
  [ -x "$APP_BIN" ] || fail "ZorinMacBridge Server executable is missing from /Applications" 66
  # Run the frozen updater as root so every downloaded/staged file remains in a
  # root-owned directory. HOME points at the desktop user only for normal app
  # paths; signing uses the root-owned token override above.
  /usr/bin/env HOME="$home" USER="$user" LOGNAME="$user" ZMB_LOCAL_IDENTITY_TOKEN="$token" "$APP_BIN" "$@"
}

parse_kv() {
  local text="$1" key="$2"
  printf '%s\n' "$text" | /usr/bin/awk -F= -v k="$key" '$1==k {sub(/^[^=]*=/, ""); print; exit}'
}

check_update_cmd() {
  require_root
  local output rc current latest available
  acquire_update_lock
  output="$(run_app_as_target_user --p0-update-check 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    write_update_status unknown unknown unknown check-failed "$output"
    release_update_lock
    printf '%s\n' "$output" >&2
    return "$rc"
  fi
  current="$(parse_kv "$output" current)"
  latest="$(parse_kv "$output" latest)"
  available="$(parse_kv "$output" available)"
  [ -n "$current" ] || current=unknown
  [ -n "$latest" ] || latest=unknown
  [ -n "$available" ] || available=unknown
  write_update_status "$current" "$latest" "$available" checked ""
  release_update_lock
  printf '%s\n' "$output"
  printf 'auto_update_mode=%s\n' "$(config_value AUTO_UPDATE notify)"
}

find_admin_payload() {
  local found
  found="$(/usr/bin/find "$APP_PATH/Contents" -type f -path '*/native/macos/admin/install-admin.sh' -print -quit 2>/dev/null || true)"
  [ -n "$found" ] && printf '%s\n' "$found"
}

update_now_cmd() {
  require_root
  local user home work output rc current latest available staged backup payload uid server_id server_name old_payload repair_out
  acquire_update_lock
  user="$(target_user || true)"; [ -n "$user" ] || { release_update_lock; fail "target user is not configured" 69; }
  uid="$(user_uid "$user" || true)"; [ -n "$uid" ] || { release_update_lock; fail "cannot resolve target user uid" 69; }
  home="$(user_home "$user" || true)"; [ -n "$home" ] || { release_update_lock; fail "cannot resolve target user home" 69; }
  server_id="$(config_value SERVER_ID '')"
  if [ -z "$server_id" ]; then
    server_id="$(settings_value "$home/.zorin-mac-bridge/server-settings.json" server_id '')"
  fi
  [ -n "$server_id" ] || { release_update_lock; fail "persistent server id is missing; run Enable / Repair once" 69; }
  server_name="$(config_value SERVER_NAME '')"
  [ -n "$server_name" ] || server_name="$(/bin/hostname -s 2>/dev/null || echo Mac)"
  work="$(/usr/bin/mktemp -d /var/tmp/zmb-update.XXXXXX)" || { release_update_lock; fail "could not create update staging directory" 73; }
  # Python Path.resolve() canonicalizes macOS /var -> /private/var. Canonicalize
  # the trusted root too before comparing the staged path, otherwise a valid
  # /private/var/tmp/... result is falsely rejected as escaping /var/tmp/....
  work="$(cd "$work" && /bin/pwd -P)" || { release_update_lock; fail "could not canonicalize update staging directory" 73; }
  /bin/chmod 700 "$work"
  /usr/sbin/chown root:wheel "$work"

  output="$(run_app_for_root_update --p0-update-stage "$work" 2>&1)"; rc=$?
  current="$(parse_kv "$output" current)"; [ -n "$current" ] || current=unknown
  latest="$(parse_kv "$output" latest)"; [ -n "$latest" ] || latest=unknown
  available="$(parse_kv "$output" available)"; [ -n "$available" ] || available=unknown
  if [ "$rc" -ne 0 ]; then
    write_update_status "$current" "$latest" "$available" stage-failed "$output"
    /bin/rm -rf "$work"
    release_update_lock
    printf '%s\n' "$output" >&2
    return "$rc"
  fi
  if [ "$available" != "1" ]; then
    write_update_status "$current" "$latest" 0 up-to-date ""
    /bin/rm -rf "$work"
    release_update_lock
    printf 'ok=up-to-date\ncurrent=%s\nlatest=%s\n' "$current" "$latest"
    return 0
  fi

  staged="$(parse_kv "$output" staged_app)"
  case "$staged" in
    "$work"/*) ;;
    *)
      write_update_status "$current" "$latest" 1 invalid-stage "staged app path escaped the trusted work directory"
      /bin/rm -rf "$work"; release_update_lock
      fail "staged app path escaped the trusted update directory" 65
      ;;
  esac
  [ -d "$staged" ] || { /bin/rm -rf "$work"; release_update_lock; fail "verified staged application is missing" 66; }
  /usr/bin/codesign --verify --deep --strict --verbose=2 "$staged" >/dev/null 2>&1 || {
    write_update_status "$current" "$latest" 1 invalid-signature "staged app failed final codesign verification"
    /bin/rm -rf "$work"; release_update_lock; fail "staged app failed final code signature verification" 65;
  }

  backup="${APP_PATH}.zmb-update-backup"
  /bin/rm -rf "$backup"
  if [ -d "$APP_PATH" ]; then /bin/mv "$APP_PATH" "$backup" || { /bin/rm -rf "$work"; release_update_lock; fail "could not create application backup" 74; }; fi
  if ! /usr/bin/ditto "$staged" "$APP_PATH"; then
    /bin/rm -rf "$APP_PATH"
    [ -d "$backup" ] && /bin/mv "$backup" "$APP_PATH" || true
    write_update_status "$current" "$latest" 1 install-failed "could not copy staged application to /Applications"
    /bin/rm -rf "$work"; release_update_lock
    fail "could not install the staged application; previous app restored" 74
  fi
  /usr/sbin/chown -R root:wheel "$APP_PATH" >/dev/null 2>&1 || true
  /usr/bin/codesign --verify --deep --strict --verbose=2 "$APP_PATH" >/dev/null 2>&1 || {
    /bin/rm -rf "$APP_PATH"
    [ -d "$backup" ] && /bin/mv "$backup" "$APP_PATH" || true
    write_update_status "$current" "$latest" 1 install-failed "installed app failed code signature verification"
    /bin/rm -rf "$work"; release_update_lock
    fail "installed app failed verification; previous app restored" 65
  }

  payload="$(find_admin_payload)"
  repair_out="$(/usr/bin/mktemp /var/tmp/zmb-admin-repair.XXXXXX)" || repair_out="/dev/null"
  if [ -z "$payload" ] || ! ZMB_UPDATE_IN_PROGRESS=1 /bin/bash "$payload" "$user" "$server_id" "$server_name" "$(config_value LOCAL_IDENTITY_TOKEN '')" >"$repair_out" 2>&1; then
    /bin/rm -rf "$APP_PATH"
    [ -d "$backup" ] && /bin/mv "$backup" "$APP_PATH" || true
    old_payload="$(find_admin_payload)"
    if [ -n "$old_payload" ]; then ZMB_UPDATE_IN_PROGRESS=1 /bin/bash "$old_payload" "$user" "$server_id" "$server_name" "$(config_value LOCAL_IDENTITY_TOKEN '')" >/dev/null 2>&1 || true; fi
    write_update_status "$current" "$latest" 1 helper-update-failed "new P0 helper installation failed; application rolled back"
    [ "$repair_out" = "/dev/null" ] || /bin/rm -f "$repair_out"
    /bin/rm -rf "$work"; release_update_lock
    fail "new P0 helper installation failed; previous app restored" 70
  fi
  [ "$repair_out" = "/dev/null" ] || /bin/rm -f "$repair_out"

  # Activate the newly installed runtime before reporting success.  In an Aqua
  # session restart the normal Desktop LaunchAgent.  At LoginWindow the old
  # pre-login process must be replaced explicitly; otherwise it keeps serving
  # the previous executable from memory even though /Applications is updated.
  if user_session_available "$uid"; then
    if ! restart_zmb >/dev/null 2>&1; then
      write_update_status "$latest" "$latest" 0 activation-failed "new app installed but Desktop restart failed"
      /bin/rm -rf "$backup" "$work"
      release_update_lock
      fail "new app installed but Desktop service could not be restarted" 70
    fi
  elif prelogin_console_active; then
    if ! restart_prelogin_current_session; then
      write_update_status "$latest" "$latest" 0 activation-failed "new app installed but LoginWindow pre-login restart failed"
      /bin/rm -rf "$backup" "$work"
      release_update_lock
      fail "new app installed but LoginWindow pre-login service could not be restarted" 70
    fi
    local port activation_attempt=1
    port="$(settings_value "$home/.zorin-mac-bridge/server-settings.json" port "$DEFAULT_PORT")"
    while [ "$activation_attempt" -le 30 ]; do
      port_listening "$port" && break
      /bin/sleep 0.25
      activation_attempt=$((activation_attempt + 1))
    done
    if ! port_listening "$port"; then
      write_update_status "$latest" "$latest" 0 activation-failed "new LoginWindow process did not reopen Desktop port $port"
      /bin/rm -rf "$backup" "$work"
      release_update_lock
      fail "new LoginWindow pre-login service did not reopen Desktop port $port" 70
    fi
  fi

  /bin/rm -rf "$backup" "$work"
  write_update_status "$latest" "$latest" 0 installed ""
  release_update_lock
  printf 'ok=updated\nprevious=%s\ninstalled=%s\n' "$current" "$latest"
}

set_auto_update_cmd() {
  require_root
  local mode="${1:-}"
  case "$mode" in off|notify|install) ;; *) fail "usage: zmb-admin set-auto-update off|notify|install" 64 ;; esac
  set_config_value AUTO_UPDATE "$mode"
  printf 'ok=auto-update-mode-set\nauto_update_mode=%s\n' "$mode"
}

auto_update_run() {
  require_root
  local mode
  mode="$(config_value AUTO_UPDATE notify)"
  case "$mode" in
    off) return 0 ;;
    notify) check_update_cmd ;;
    install) update_now_cmd ;;
    *) fail "invalid AUTO_UPDATE mode in admin config: $mode" 65 ;;
  esac
}

