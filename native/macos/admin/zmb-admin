  printf 'prelogin_agent_exists=%s\n' "$prelogin_agent_exists"
  printf 'prelogin_agent_loaded=%s\n' "$prelogin_agent_loaded"
  printf 'prelogin_console_active=%s\n' "$prelogin_console"
  printf 'prelogin_ready=%s\n' "$prelogin_ready"
  printf 'prelogin_release_identity_ready=%s\n' "$prelogin_release_identity_ready"
  printf 'prelogin_probe_present=%s\n' "$prelogin_probe_present"
