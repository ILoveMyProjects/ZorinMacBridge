paired_devices_count() {
  local u home f
  u="$(target_user || true)"
  [ -n "$u" ] || { printf '%s\n' 0; return; }
  home="$(user_home "$u" || true)"
  f="$home/.ssh/authorized_keys"
  /usr/bin/sudo -u "$u" /usr/bin/test -f "$f" 2>/dev/null || { printf '%s\n' 0; return; }
  /usr/bin/sudo -u "$u" /usr/bin/grep -c 'ZorinMacBridge-Admin:' "$f" 2>/dev/null || true
}

desktop_tls_fingerprint() {
  # This value is returned only through the already-pinned P0 SSH channel.
  # It bridges the verified SSH identity to the desktop TLS identity so the
  # user performs one pairing ceremony instead of manually trusting a second
  # fingerprint. Never advertise this as a trust source over unauthenticated
  # discovery.
  local u home cert fp
  u="$(target_user || true)"
  [ -n "$u" ] || { printf '%s\n' unavailable; return; }
  home="$(user_home "$u" || true)"
  [ -n "$home" ] || { printf '%s\n' unavailable; return; }
  cert="$home/.zorin-mac-bridge/server-cert.pem"
  [ -f "$cert" ] || { printf '%s\n' missing; return; }
  [ -x /usr/bin/openssl ] || { printf '%s\n' unavailable; return; }
  fp="$(/usr/bin/openssl x509 -in "$cert" -noout -fingerprint -sha256 2>/dev/null | /usr/bin/sed -n 's/^.*=//p' | /usr/bin/tr 'a-f' 'A-F' | /usr/bin/head -n1)"
  if printf '%s' "$fp" | /usr/bin/grep -Eq '^([0-9A-F]{2}:){31}[0-9A-F]{2}$'; then
    printf '%s\n' "$fp"
  else
    printf '%s\n' unavailable
  fi
}

