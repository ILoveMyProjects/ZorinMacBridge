  printf 'prelogin_probe_input_corehid=%s\n' "$prelogin_probe_input_corehid"
  printf 'prelogin_probe_input_legacy=%s\n' "$prelogin_probe_input_legacy"
  printf 'auto_start_server=%s\n' "$auto_start"
