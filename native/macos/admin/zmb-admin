wake_display_cmd() {
  require_root
  # A short user-activity assertion turns an off display back on without
  # changing the normal lock/login/sleep policy. When a GUI session exists,
  # issue it inside that user's launchd context so the wake reaches the active
  # login/desktop session; fall back to a system assertion at loginwindow.
  local user uid
  user="$(target_user || true)"
  uid="$(user_uid "$user" || true)"
  if [ -n "$user" ] && [ -n "$uid" ] && user_session_available "$uid"; then
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/caffeinate -u -t 8 >/dev/null 2>&1 &
  else
    /usr/bin/caffeinate -u -t 8 >/dev/null 2>&1 &
  fi
  printf 'ok=display-wake-requested\n'
}

